#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${repo_root}"

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "missing required command '$1'; run 'nix develop' or install it and retry" >&2
        exit 127
    fi
}

require_command cargo

profile="${GAMMABOARD_PROFILE:-dev-optim}"
case "${profile}" in
    dev-optim)
        build_args=(--profile dev-optim)
        bin="${repo_root}/target/dev-optim/gammaboard"
        ;;
    release)
        build_args=(--release)
        bin="${repo_root}/target/release/gammaboard"
        ;;
    debug)
        build_args=()
        bin="${repo_root}/target/debug/gammaboard"
        ;;
    *)
        echo "unsupported GAMMABOARD_PROFILE=${profile}; expected dev-optim, release, or debug" >&2
        exit 2
        ;;
esac

uses_deploy=false
rebuild_frontend=false
forwarded_args=()
for arg in "$@"; do
    case "${arg}" in
        deploy)
            uses_deploy=true
            forwarded_args+=("${arg}")
            ;;
        --rebuild-frontend)
            rebuild_frontend=true
            forwarded_args+=("${arg}")
            ;;
        *)
            forwarded_args+=("${arg}")
            ;;
    esac
done

if [[ "${rebuild_frontend}" == true && "${uses_deploy}" == false ]]; then
    echo "--rebuild-frontend is only valid with deploy" >&2
    exit 2
fi

frontend_needs_build() {
    local output="${repo_root}/dashboard/build/index.html"
    local base_stamp="${repo_root}/dashboard/build/.gammaboard-frontend-base"
    local requested_base="${GAMMABOARD_FRONTEND_BASE:-/}"
    if [[ "${rebuild_frontend}" == true || ! -f "${output}" ]]; then
        return 0
    fi
    if [[ ! -f "${base_stamp}" || "$(<"${base_stamp}")" != "${requested_base}" ]]; then
        return 0
    fi

    local input
    for input in \
        "${repo_root}/dashboard/index.html" \
        "${repo_root}/dashboard/package.json" \
        "${repo_root}/dashboard/package-lock.json" \
        "${repo_root}/dashboard/vite.config.js"; do
        if [[ "${input}" -nt "${output}" ]]; then
            return 0
        fi
    done

    [[ -n "$(find "${repo_root}/dashboard/src" "${repo_root}/dashboard/public" -type f -newer "${output}" -print -quit)" ]]
}

if [[ "${uses_deploy}" == true ]]; then
    require_command npm
    cd "${repo_root}/dashboard"
    if [[ ! -x node_modules/.bin/vite ]]; then
        npm ci
        frontend_dependencies_installed=true
    else
        frontend_dependencies_installed=false
    fi

    if [[ "${frontend_dependencies_installed}" == true ]] || frontend_needs_build; then
        npm run build
        printf '%s\n' "${GAMMABOARD_FRONTEND_BASE:-/}" > build/.gammaboard-frontend-base
    else
        echo "frontend build is current; skipping npm run build"
    fi
    cd "${repo_root}"
fi

cargo build "${build_args[@]}"
exec "${bin}" "${forwarded_args[@]}"
