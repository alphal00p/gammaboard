#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${repo_root}"

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "missing required command '$1'; run 'nix develop' or install it and retry" >&2
        exit 127
    fi
}

require_command cargo

# Local builds use the regular Symbolica runtime path unless an OEM build is
# explicitly requested. Non-Symbolica evaluators then need no license.
if [[ -z "${SYMBOLICA_OEM_LICENSE:-}" && -z "${NO_SYMBOLICA_OEM_LICENSE:-}" ]]; then
    export NO_SYMBOLICA_OEM_LICENSE=1
fi

profile="${GAMMABOARD_PROFILE:-dev-optim}"
case "${profile}" in
    dev-optim)
        build_args=(--profile dev-optim)
        bin="${repo_root}/target/dev-optim/gammaboard"
        ;;
    release)
        build_args=(--release)
        bin="${repo_root}/target/release/gammaboard"
        ;;
    debug)
        build_args=()
        bin="${repo_root}/target/debug/gammaboard"
        ;;
    *)
        echo "unsupported GAMMABOARD_PROFILE=${profile}; expected dev-optim, release, or debug" >&2
        exit 2
        ;;
esac

uses_deploy_run=false
for ((i = 1; i < $#; i++)); do
    if [[ "${!i}" == "deploy" ]]; then
        next_index=$((i + 1))
        if ((next_index <= $#)) && [[ "${!next_index}" == "run" ]]; then
            uses_deploy_run=true
            break
        fi
    fi
done

if [[ "${uses_deploy_run}" == true ]]; then
    require_command npm
    cd "${repo_root}/dashboard"
    if [[ ! -x node_modules/.bin/vite ]]; then
        npm ci
    fi

    npm run build
    cd "${repo_root}"
fi

cargo build "${build_args[@]}"
exec "${bin}" "$@"
