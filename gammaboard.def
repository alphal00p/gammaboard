Bootstrap: docker
From: rust:1-bookworm

%files
    ../gammaloop /opt/gammaloop
    ../gammaboard /opt/gammaboard

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    # Share one target dir across both repos and force identical release profile settings
    # so Cargo can reuse compiled artifacts between gammaloop and gammaboard builds.
    export CARGO_TARGET_DIR=/opt/target
    export CARGO_PROFILE_RELEASE_LTO=fat
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        pkg-config \
        libssl-dev \
        libgmp-dev \
        libmpfr-dev \
        libmpc-dev \
        gfortran \
        m4

    update-ca-certificates

    # Build gammaloop CLI without Python
    cd /opt/gammaloop
    cargo build -p gammaloop-api --bin gammaloop \
        --no-default-features --features cli,no_pyo3 --release

    # Build gammaboard with the same target dir so Cargo can reuse artifacts
    cd /opt/gammaboard
    cargo build --release

    # Install both binaries
    install -Dm755 /opt/target/release/gammaloop /usr/local/bin/gammaloop
    install -Dm755 /opt/target/release/gammaboard /usr/local/bin/gammaboard

    # Keep image size under control
    rm -rf /opt/target
    rm -rf /root/.cargo/registry /root/.cargo/git
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/usr/local/bin:$PATH

%runscript
    exec "$@"

%test
    test -x /usr/local/bin/gammaloop
    test -x /usr/local/bin/gammaboard
