Bootstrap: docker
From: python:3.12-bookworm

%setup
    mkdir -p "${APPTAINER_ROOTFS}/workspace/resources/runtimes/madnis_gammaboard_api"

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        zlib1g \
        libgmp10 \
        libmpfr6 \
        libmpc3 \
        libgfortran5

    update-ca-certificates

    PROJECT_DIR="${PYTHON_PROJECT_DIR:-/workspace/resources/runtimes/madnis_gammaboard_api}"
    test -f "${PROJECT_DIR}/pyproject.toml"
    test -d "${PROJECT_DIR}/src"
    rm -rf /tmp/gammaboard-python-runtime
    mkdir -p /tmp/gammaboard-python-runtime
    cp -a "${PROJECT_DIR}/." /tmp/gammaboard-python-runtime/

    python -m pip install --root-user-action=ignore --no-cache-dir --upgrade pip setuptools wheel
    python -m pip install --root-user-action=ignore --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch
    python -m pip install --root-user-action=ignore --no-cache-dir --no-build-isolation \
        "madnis @ git+https://github.com/madgraph-ml/madnis.git@main"
    python -m pip install --root-user-action=ignore --no-cache-dir --no-build-isolation /tmp/gammaboard-python-runtime
    python - <<'PY'
import importlib.util
import shutil
import site
from pathlib import Path

project_src = Path("/tmp/gammaboard-python-runtime/src/madnis_gammaboard_api")
project_file = Path("/tmp/gammaboard-python-runtime/src/madnis_gammaboard_api.py")
sampler_file = Path("/tmp/gammaboard-python-runtime/src/madnis_sampler.py")
if importlib.util.find_spec("madnis_gammaboard_api") is None and importlib.util.find_spec("madnis_sampler") is None:
    target_root = Path(site.getsitepackages()[0])
    if project_src.is_dir():
        shutil.copytree(project_src, target_root / "madnis_gammaboard_api", dirs_exist_ok=True)
    elif project_file.is_file():
        shutil.copy2(project_file, target_root / "madnis_gammaboard_api.py")
    elif sampler_file.is_file():
        shutil.copy2(sampler_file, target_root / "madnis_sampler.py")
    else:
        raise SystemExit(
            "runtime sampler module was not installed and no supported src module was found"
        )
PY
    python - <<'PY'
import madnis
import madnis_sampler
print("python runtime import check ok")
PY

    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/gammaboard-python-runtime

%environment
    export OMP_NUM_THREADS="${OMP_NUM_THREADS:-64}"
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%test
    python - <<'PY'
import madnis
import madnis_sampler
print("python runtime ok")
PY
