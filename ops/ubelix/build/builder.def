Bootstrap: docker
From: rust:1-bookworm

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        python3 \
        python3-dev \
        pkg-config \
        libssl-dev \
        libgmp-dev \
        libmpfr-dev \
        libmpc-dev \
        gfortran \
        m4

    update-ca-certificates

    cargo install just --locked
    cargo install sccache --locked

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/root/.cargo/bin:/usr/local/cargo/bin:/usr/local/bin:$PATH

%runscript
    exec "$@"

%test
    command -v cargo
    command -v rustc
    command -v just
    command -v sccache
