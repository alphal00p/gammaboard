Bootstrap: docker
From: rust:1-bookworm

%setup
    mkdir -p "${APPTAINER_ROOTFS}/workspace/artifacts/bin"
    mkdir -p "${APPTAINER_ROOTFS}/workspace/artifacts/bin/lib"
    mkdir -p "${APPTAINER_ROOTFS}/workspace/artifacts/migrations"

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        libgfortran5 \
        tzdata \
        postgresql \
        postgresql-contrib

    update-ca-certificates

    PG_BINDIR="$(pg_config --bindir)"
    for bin in initdb pg_ctl psql createdb dropdb; do
      if [ -x "${PG_BINDIR}/${bin}" ]; then
        ln -sf "${PG_BINDIR}/${bin}" "/usr/local/bin/${bin}"
      fi
    done

    GAMMALOOP_BIN="${GAMMALOOP_BIN:-/workspace/artifacts/bin/gammaloop}"
    GAMMABOARD_BIN="${GAMMABOARD_BIN:-/workspace/artifacts/bin/gammaboard}"
    SQLX_BIN="${SQLX_BIN:-/workspace/artifacts/bin/sqlx}"
    MIGRATIONS_DIR="${MIGRATIONS_DIR:-/workspace/artifacts/migrations}"
    test -x "${GAMMALOOP_BIN}"
    test -x "${GAMMABOARD_BIN}"
    test -x "${SQLX_BIN}"
    test -d "${MIGRATIONS_DIR}"
    install -Dm755 "${GAMMALOOP_BIN}" /usr/local/bin/gammaloop
    install -Dm755 "${GAMMABOARD_BIN}" /usr/local/bin/gammaboard
    install -Dm755 "${SQLX_BIN}" /usr/local/bin/sqlx
    mkdir -p /usr/local/share/gammaboard/migrations
    cp -a "${MIGRATIONS_DIR}/." /usr/local/share/gammaboard/migrations/
    mkdir -p /usr/local/lib/gammaboard
    for lib in /workspace/artifacts/bin/lib/*.so*; do
      if [ -e "${lib}" ]; then
        cp -L "${lib}" /usr/local/lib/gammaboard/
      fi
    done

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib/gammaboard:${LD_LIBRARY_PATH:-}
    export TZ=Etc/UTC
    export GAMMABOARD_MIGRATIONS_DIR=/usr/local/share/gammaboard/migrations

%runscript
    exec "$@"

%test
    test -x /usr/local/bin/gammaloop
    test -x /usr/local/bin/gammaboard
