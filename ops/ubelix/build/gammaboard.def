Bootstrap: docker
From: rust:1-bookworm

%setup
    mkdir -p "${APPTAINER_ROOTFS}/workspace/artifacts/bin"
    mkdir -p "${APPTAINER_ROOTFS}/workspace/artifacts/bin/lib"

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        python3 \
        libgfortran5 \
        tzdata \
        nginx \
        postgresql \
        postgresql-contrib

    mkdir -p /etc/apt/keyrings
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list
    apt-get update
    apt-get install -y --no-install-recommends nodejs

    update-ca-certificates

    PG_BINDIR="$(pg_config --bindir)"
    for bin in initdb pg_ctl psql createdb dropdb; do
      if [ -x "${PG_BINDIR}/${bin}" ]; then
        ln -sf "${PG_BINDIR}/${bin}" "/usr/local/bin/${bin}"
      fi
    done

    GAMMABOARD_BIN="${GAMMABOARD_BIN:-/workspace/artifacts/bin/gammaboard}"
    SQLX_BIN="${SQLX_BIN:-/workspace/artifacts/bin/sqlx}"
    MIGRATIONS_DIR="${MIGRATIONS_DIR:-/workspace/artifacts/src/gammaboard/migrations}"
    DASHBOARD_SOURCE_DIR="${DASHBOARD_SOURCE_DIR:-/workspace/artifacts/src/gammaboard/dashboard}"
    test -x "${GAMMABOARD_BIN}"
    test -x "${SQLX_BIN}"
    test -d "${MIGRATIONS_DIR}"
    test -f "${DASHBOARD_SOURCE_DIR}/package-lock.json"
    install -Dm755 "${GAMMABOARD_BIN}" /usr/local/bin/gammaboard
    install -Dm755 "${SQLX_BIN}" /usr/local/bin/sqlx
    mkdir -p /usr/local/share/gammaboard/migrations
    cp -a "${MIGRATIONS_DIR}/." /usr/local/share/gammaboard/migrations/
    rm -rf /tmp/gammaboard-dashboard
    mkdir -p /tmp/gammaboard-dashboard
    cp -a "${DASHBOARD_SOURCE_DIR}/." /tmp/gammaboard-dashboard/
    cd /tmp/gammaboard-dashboard
    npm_config_update_notifier=false npm ci
    npm_config_update_notifier=false npm run build
    test -f build/index.html
    mkdir -p /usr/local/share/gammaboard/dashboard
    cp -a build/. /usr/local/share/gammaboard/dashboard/
    mkdir -p /usr/local/lib/gammaboard
    for lib in /workspace/artifacts/bin/lib/*.so*; do
      if [ -e "${lib}" ]; then
        cp -L "${lib}" /usr/local/lib/gammaboard/
      fi
    done

    apt-get purge -y nodejs
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib/gammaboard:${LD_LIBRARY_PATH:-}
    export TZ=Etc/UTC
    export GAMMABOARD_MIGRATIONS_DIR=/usr/local/share/gammaboard/migrations

%runscript
    exec "$@"

%test
    test -x /usr/local/bin/gammaboard
    test -f /usr/local/share/gammaboard/dashboard/index.html
