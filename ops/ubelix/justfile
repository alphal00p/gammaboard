sync-ops host="Ubelix" remote_root="/storage/research/itp_localunitaritydata":
    #!/usr/bin/env bash
    set -euo pipefail
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    cd "${REPO_ROOT}"
    ssh "{{host}}" "mkdir -p '{{remote_root}}/ops/build' '{{remote_root}}/ops/config' '{{remote_root}}/ops/slurm'"
    scp -r ops/ubelix/build/* "{{host}}:{{remote_root}}/ops/build/"
    scp -r ops/ubelix/config/* "{{host}}:{{remote_root}}/ops/config/"
    scp -r ops/ubelix/slurm/* "{{host}}:{{remote_root}}/ops/slurm/"
    scp ops/ubelix/ubelix.py "{{host}}:{{remote_root}}/ubelix.py"
    scp ops/ubelix/justfile "{{host}}:{{remote_root}}/justfile"
    scp ops/ubelix/README.md "{{host}}:{{remote_root}}/README.md"

sync-dashboard host="Ubelix" remote_root="/storage/research/itp_localunitaritydata":
    #!/usr/bin/env bash
    set -euo pipefail
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    cd "${REPO_ROOT}"
    just build-frontend
    ssh "{{host}}" "rm -rf '{{remote_root}}/artifacts/dashboard-build' && mkdir -p '{{remote_root}}/artifacts'"
    scp -r dashboard/build "{{host}}:{{remote_root}}/artifacts/dashboard-build"

prune-images:
    #!/usr/bin/env bash
    set -euo pipefail

    WORKSPACE_ROOT="${GAMMABOARD_WORKSPACE_ROOT:-/storage/research/itp_localunitaritydata}"

    prune_family() {
      local family="$1"
      local dir="${WORKSPACE_ROOT}/images/${family}"
      local latest_link="${dir}/${family}-latest.sif"
      if [[ ! -d "${dir}" ]]; then
        echo "skip ${family}: missing dir ${dir}"
        return
      fi
      if [[ ! -L "${latest_link}" ]]; then
        echo "skip ${family}: missing latest symlink ${latest_link}"
        return
      fi

      local keep_sif
      keep_sif="$(basename "$(readlink -f "${latest_link}")")"
      local keep_meta="${keep_sif%.sif}.meta"

      echo "pruning ${family}: keeping ${keep_sif} and ${keep_meta}"
      shopt -s nullglob
      for f in "${dir}"/*.sif; do
        local base
        base="$(basename "${f}")"
        if [[ "${base}" == "${keep_sif}" || "${base}" == "${family}-latest.sif" ]]; then
          continue
        fi
        rm -f "${f}"
        echo "removed ${f}"
      done
      for f in "${dir}"/*.meta; do
        local base
        base="$(basename "${f}")"
        if [[ "${base}" == "${keep_meta}" ]]; then
          continue
        fi
        rm -f "${f}"
        echo "removed ${f}"
      done
      shopt -u nullglob
    }

    prune_family gammaloop
    prune_family gammaboard
