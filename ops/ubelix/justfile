submit-ui-with-two-workers:
    #!/usr/bin/env bash
    set -euo pipefail

    WORKSPACE_ROOT="${GAMMABOARD_WORKSPACE_ROOT:-/storage/research/itp_localunitaritydata}"
    IMAGE_PATH="${GAMMABOARD_IMAGE:-${WORKSPACE_ROOT}/images/gammaboard/gammaboard-latest.sif}"
    WAIT_SECONDS="${CONTROL_NODE_WAIT_SECONDS:-180}"

    mkdir -p "${WORKSPACE_ROOT}/logs/slurm/control" "${WORKSPACE_ROOT}/logs/slurm/workers" "${WORKSPACE_ROOT}/logs/postgres"
    if [[ ! -f "${IMAGE_PATH}" ]]; then
      echo "missing image: ${IMAGE_PATH}" >&2
      exit 1
    fi

    ui_submit="$(sbatch --chdir "${WORKSPACE_ROOT}" "${WORKSPACE_ROOT}/ops/slurm/control_ui_single.sbatch")"
    echo "${ui_submit}"
    ui_job_id="$(awk '/Submitted batch job/{print $4}' <<<"${ui_submit}")"
    if [[ -z "${ui_job_id}" ]]; then
      echo "failed to parse control job id from sbatch output" >&2
      exit 1
    fi

    deadline=$((SECONDS + WAIT_SECONDS))
    control_node=""
    while (( SECONDS < deadline )); do
      control_node="$(squeue -h -j "${ui_job_id}" -o "%N" || true)"
      if [[ -n "${control_node}" && "${control_node}" != "(null)" ]]; then
        break
      fi
      sleep 2
    done
    if [[ -z "${control_node}" || "${control_node}" == "(null)" ]]; then
      echo "timed out waiting for control node assignment for job ${ui_job_id}" >&2
      exit 1
    fi

    worker_db_url="postgresql://postgres:postgres@${control_node}:5433/gammaboard_db"

    w1_submit="$(
      NODE_NAME=w-1 \
      GAMMABOARD_DATABASE_URL="${worker_db_url}" \
      GAMMABOARD_IMAGE="${IMAGE_PATH}" \
      GAMMABOARD_WORKSPACE_ROOT="${WORKSPACE_ROOT}" \
      sbatch --chdir "${WORKSPACE_ROOT}" "${WORKSPACE_ROOT}/ops/slurm/node_worker.sbatch"
    )"
    w2_submit="$(
      NODE_NAME=w-2 \
      GAMMABOARD_DATABASE_URL="${worker_db_url}" \
      GAMMABOARD_IMAGE="${IMAGE_PATH}" \
      GAMMABOARD_WORKSPACE_ROOT="${WORKSPACE_ROOT}" \
      sbatch --chdir "${WORKSPACE_ROOT}" "${WORKSPACE_ROOT}/ops/slurm/node_worker.sbatch"
    )"

    echo "${w1_submit}"
    echo "${w2_submit}"
    echo "control_job_id=${ui_job_id}"
    echo "control_node=${control_node}"

tunnel-job job_id local_port="8080":
    #!/usr/bin/env bash
    set -euo pipefail
    SSH_TARGET="${SSH_TARGET:-cs22u040@submit03.unibe.ch}"
    FRONTEND_PORT="8080"
    NODE_NAME="$(ssh "${SSH_TARGET}" "squeue -h -j {{job_id}} -o '%N'")"
    if [[ -z "${NODE_NAME}" || "${NODE_NAME}" == "(null)" ]]; then
      echo "could not resolve node for job {{job_id}} (is it running?)" >&2
      exit 1
    fi
    ssh -N -L "{{local_port}}:${NODE_NAME}:${FRONTEND_PORT}" "${SSH_TARGET}"

prune-images:
    #!/usr/bin/env bash
    set -euo pipefail

    WORKSPACE_ROOT="${GAMMABOARD_WORKSPACE_ROOT:-/storage/research/itp_localunitaritydata}"

    prune_family() {
      local family="$1"
      local dir="${WORKSPACE_ROOT}/images/${family}"
      local latest_link="${dir}/${family}-latest.sif"
      if [[ ! -d "${dir}" ]]; then
        echo "skip ${family}: missing dir ${dir}"
        return
      fi
      if [[ ! -L "${latest_link}" ]]; then
        echo "skip ${family}: missing latest symlink ${latest_link}"
        return
      fi

      local keep_sif
      keep_sif="$(basename "$(readlink -f "${latest_link}")")"
      local keep_meta="${keep_sif%.sif}.meta"

      echo "pruning ${family}: keeping ${keep_sif} and ${keep_meta}"
      shopt -s nullglob
      for f in "${dir}"/*.sif; do
        local base
        base="$(basename "${f}")"
        if [[ "${base}" == "${keep_sif}" || "${base}" == "${family}-latest.sif" ]]; then
          continue
        fi
        rm -f "${f}"
        echo "removed ${f}"
      done
      for f in "${dir}"/*.meta; do
        local base
        base="$(basename "${f}")"
        if [[ "${base}" == "${keep_meta}" ]]; then
          continue
        fi
        rm -f "${f}"
        echo "removed ${f}"
      done
      shopt -u nullglob
    }

    prune_family gammaloop
    prune_family gammaboard
