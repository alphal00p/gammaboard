sync-ops host="Ubelix" remote_root="/storage/research/itp_localunitaritydata":
    #!/usr/bin/env bash
    set -euo pipefail
    ssh "{{host}}" "mkdir -p '{{remote_root}}/ops'"
    scp -r ./* "{{host}}:{{remote_root}}/ops/"

submit-hello-single:
    #!/usr/bin/env bash
    set -euo pipefail
    sbatch ops/slurm/hello_single.sbatch

submit-ui-single:
    #!/usr/bin/env bash
    set -euo pipefail
    sbatch ops/slurm/control_ui_single.sbatch

tunnel-job job_id local_port="8080":
    #!/usr/bin/env bash
    set -euo pipefail
    LOGIN_HOST="Ubelix"
    SSH_USER="${SSH_USER:-${USER}}"
    FRONTEND_PORT="8080"
    NODE_NAME="$(ssh "${SSH_USER}@${LOGIN_HOST}" "squeue -h -j {{job_id}} -o '%N'")"
    if [[ -z "${NODE_NAME}" || "${NODE_NAME}" == "(null)" ]]; then
      echo "could not resolve node for job {{job_id}} (is it running?)" >&2
      exit 1
    fi
    ssh -N -L "{{local_port}}:${NODE_NAME}:${FRONTEND_PORT}" "${SSH_USER}@${LOGIN_HOST}"
