bin := "./target/dev-optim/gammaboard"
release_bin := "./target/release/gammaboard"
deploy_cfg := "ops/itphlies/config/deploy.toml"
runtime_cfg := "ops/itphlies/config/runtime.toml"

deploy mode="release" port_offset="0":
    #!/usr/bin/env bash
    set -euo pipefail

    cd ../..
    offset="{{port_offset}}"
    if ! [[ "${offset}" =~ ^[0-9]+$ ]]; then
        echo "port offset must be a non-negative integer: ${offset}" >&2
        exit 1
    fi

    just build-frontend
    if [[ "{{mode}}" == "release" ]]; then
        just build-backend-release
        deploy_bin="{{release_bin}}"
    else
        just build-backend
        deploy_bin="{{bin}}"
    fi

    cmd=(
        "${deploy_bin}"
        --runtime-config "{{runtime_cfg}}"
        deploy run
        --deploy-config "{{deploy_cfg}}"
        --port-offset "${offset}"
    )
    exec "${cmd[@]}"
