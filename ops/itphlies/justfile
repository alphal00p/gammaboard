bin := "./target/dev-optim/gammaboard"
release_bin := "./target/release/gammaboard"
deploy_cfg := "ops/itphlies/config/deploy.toml"
runtime_cfg := "configs/runtime/default.toml"

deploy mode="release":
    #!/usr/bin/env bash
    set -euo pipefail

    cd ../..
    just build-frontend
    if [[ "{{mode}}" == "release" ]]; then
        just build-backend-release
        {{release_bin}} --runtime-config "{{runtime_cfg}}" deploy run --deploy-config "{{deploy_cfg}}"
    else
        just build-backend
        {{bin}} --runtime-config "{{runtime_cfg}}" deploy run --deploy-config "{{deploy_cfg}}"
    fi
